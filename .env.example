# Environment variables for the REST API Aggregator
# These should be set in your deployment environment (e.g., Kubernetes Secrets, Docker Compose env file, or CI/CD variables)

# Security Credentials
# Use a strong, unique password for the admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=your_secure_password_here

# Database Configuration (If not using H2 in-memory)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/aggregator_db
# SPRING_DATASOURCE_USERNAME=db_user
# SPRING_DATASOURCE_PASSWORD=db_password
